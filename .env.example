# ---------------------------------------------------------------
# Endereco do site (usado no sitemap, robots e links compartilhados)
# Em desenvolvimento pode deixar como esta.
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Liga a beta gratuita. Deixe true enquanto estiver validando sem cobrar.
# Para reativar checkout pago, troque para false na Vercel e faça novo deploy.
NEXT_PUBLIC_PLANVORO_BETA_ACCESS=true

# ---------------------------------------------------------------
# Supabase — projeto "planvoro" (plano gratuito)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://kqmidnynzynnjejvltmo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole_aqui_a_publishable_key
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key

# ---------------------------------------------------------------
# IA que gera os roteiros
# gemini    = gratuito, sem cartao  (padrao)
# anthropic = pago, melhor qualidade
# ---------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=cole_aqui_a_chave_gratuita
# Opcional: deixe comentado para usar o padrao do app.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=LOW
# GEMINI_TIMEOUT_MS=42000
# GEMINI_MAX_OUTPUT_TOKENS=7000
# GEMINI_AGENT_TIMEOUT_MS=28000
# GEMINI_AGENT_MAX_OUTPUT_TOKENS=1800

# So preencha quando tiver orcamento e trocar LLM_PROVIDER para anthropic
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# Verificacao dos lugares (antialucinacao)
# nominatim = OpenStreetMap, gratuito e sem cartao  (padrao)
# google    = mais preciso, exige cartao cadastrado
# off       = desliga a verificacao
# ---------------------------------------------------------------
PLACES_PROVIDER=nominatim
# Obrigatorio pela politica do OpenStreetMap: troque pelo seu email real
NOMINATIM_USER_AGENT=Planvoro/0.1 (contato: seu-email@exemplo.com)

GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------
# Convites por e-mail com Resend
# Pode comecar com onboarding@resend.dev enquanto seu dominio nao
# estiver verificado no Resend.
# ---------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Planvoro <onboarding@resend.dev>
# RESEND_REPLY_TO=voce@seudominio.com

# ---------------------------------------------------------------
# Pagamentos com Stripe
# Os IDs de preço sao opcionais: sem eles, o app cria price_data
# direto no Checkout usando R$79 e R$149/ano.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_TRIP_PASS=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
